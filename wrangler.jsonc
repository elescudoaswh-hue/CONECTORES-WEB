{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "conectores-web",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-20",
  "keep_vars": true,
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
